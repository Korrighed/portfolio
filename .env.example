# Session
SESSION_SECRET=change-me-min-32-caracteres-aleatoires

# Code d'acces enseignant (un seul code, pas d'identifiant)
# Hash bcrypt du code (jamais le code en clair)
# Generer avec : node scripts/hash-password.js "mon-code"
AUTH_PASSWORD_HASH=

# Stockage PDF : nom du store Netlify Blobs (optionnel, defaut "fiches-reflexives")
PDF_BLOB_STORE=fiches-reflexives
